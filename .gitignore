# the private blocklist lives outside the repo; never let a copy in (blocklist.txt, and the old name negra.txt)
blocklist.txt
**/blocklist.txt
negra.txt
**/negra.txt
__pycache__/
.pytest_cache/
*.pyc
.DS_Store

# the graphify map is generated from the user's notes: it does not go into the repo
graphify-out/

# Obsidian writes window state here; only app.json is versioned
vault/.obsidian/*
!vault/.obsidian/app.json

# team mode: what is intimate stays on the person's machine (git has no permission per folder)
vault/people/*/private/
