#!/bin/sh
# pre-commit — a torneira, e não o balde.
#
# Dois guardas, os dois só olham o que ESTE commit leva (gate que reprova por coisa que você
# não fez é gate que as pessoas aprendem a pular):
#   1. anel      nota .md do vault/ sem nenhum link de entrada ou saída
#   2. vazamento caminho de máquina, e-mail, telefone, CPF e a sua lista negra privada
#
# Versionado em .githooks/ porque hook em .git/hooks/ some no próximo clone, e o
# `core.hooksPath` é config LOCAL: depois de clonar, rode `sh instalar.sh`.
# Escape consciente: git commit --no-verify

raiz=$(git rev-parse --show-toplevel) || exit 1
cd "$raiz" || exit 1

for f in nucleo/anel.py nucleo/vazamento.py; do
    if [ ! -f "$f" ]; then
        echo "" >&2
        echo "  ⛔ COMMIT BLOQUEADO — $f não existe: a instalação está incompleta." >&2
        echo "     Rode: sh instalar.sh" >&2
        echo "" >&2
        exit 1
    fi
done

saida=$(mktemp) || exit 1
trap 'rm -f "$saida"' EXIT
bloqueado=0

# 1. o anel
if git diff --cached --name-only --diff-filter=ACMR | grep -q '\.md$'; then
    if ! python3 nucleo/anel.py --vault vault --gate --stage >"$saida" 2>&1; then
        echo ""
        echo "  ⛔ COMMIT BLOQUEADO — nota deste commit sem nenhuma aresta no grafo"
        echo ""
        sed 's/^/     /' "$saida" | head -20
        bloqueado=1
    elif grep -q '^AVISO' "$saida"; then
        sed -n '/^AVISO/,/^$/p' "$saida" | sed 's/^/  /'
    fi
fi

# 2. o vazamento
if ! python3 nucleo/vazamento.py --staged >"$saida" 2>&1; then
    echo ""
    echo "  ⛔ COMMIT BLOQUEADO — vazamento de dado pessoal no que vai pro commit"
    echo ""
    sed 's/^/     /' "$saida" | head -20
    echo ""
    echo "  Tire o dado do arquivo (a saída acima diz arquivo:linha:tipo, nunca o dado)."
    bloqueado=1
elif grep -q 'NAO_VERIFICADO' "$saida"; then
    grep 'NAO_VERIFICADO' "$saida" | sed 's/^/  /'
fi

[ "$bloqueado" -eq 0 ] || { echo "  Escape consciente: git commit --no-verify"; echo ""; exit 1; }
exit 0
