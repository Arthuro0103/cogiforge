#!/bin/sh
# pre-commit — the tap, not the bucket.
#
# Two guards, and both only look at what THIS commit carries (a gate that fails you for something you
# did not do is a gate people learn to skip):
#   1. ring   a vault/ .md note with no inbound or outbound link
#   2. leak   machine path, e-mail, phone, CPF and your private blocklist
#
# Versioned in .githooks/ because a hook in .git/hooks/ vanishes on the next clone, and
# `core.hooksPath` is LOCAL config: after cloning, run `sh install.sh`.
# Deliberate bypass: git commit --no-verify

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

for f in core/ring.py core/leak.py; do
    if [ ! -f "$f" ]; then
        echo "" >&2
        echo "  ⛔ COMMIT BLOCKED — $f does not exist: the installation is incomplete." >&2
        echo "     Run: sh install.sh" >&2
        echo "" >&2
        exit 1
    fi
done

out=$(mktemp) || exit 1
trap 'rm -f "$out"' EXIT
blocked=0

# 1. the ring
if git diff --cached --name-only --diff-filter=ACMR | grep -q '\.md$'; then
    if ! python3 core/ring.py --vault vault --gate --stage >"$out" 2>&1; then
        echo ""
        echo "  ⛔ COMMIT BLOCKED — a note in this commit has no edge in the graph"
        echo ""
        sed 's/^/     /' "$out" | head -20
        blocked=1
    elif grep -q '^WARNING' "$out"; then
        sed -n '/^WARNING/,/^$/p' "$out" | sed 's/^/  /'
    fi
fi

# 2. the leak
if ! python3 core/leak.py --staged >"$out" 2>&1; then
    echo ""
    echo "  ⛔ COMMIT BLOCKED — personal data leak in what is going into the commit"
    echo ""
    sed 's/^/     /' "$out" | head -20
    echo ""
    echo "  Take the data out of the file (the output above says file:line:type, never the data)."
    blocked=1
elif grep -q 'NOT_VERIFIED' "$out"; then
    grep 'NOT_VERIFIED' "$out" | sed 's/^/  /'
fi
# the leak scanner warns when the private list still has its old name (negra.txt)
grep '^WARNING' "$out" | sed 's/^/  /' || true

[ "$blocked" -eq 0 ] || { echo "  Deliberate bypass: git commit --no-verify"; echo ""; exit 1; }
exit 0
