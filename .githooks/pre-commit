#!/bin/sh
# pre-commit — the tap, not the bucket.
#
# Four guards, and all only look at what THIS commit carries (a gate that fails you for something you
# did not do is a gate people learn to skip):
#   1. ring   a vault/ .md note with no inbound or outbound link
#   2. leak   machine path, e-mail, phone, CPF and your private blocklist
#   3. people team mode only (vault/roles.txt exists): a member touching another person's folder,
#             roles.txt, areas.txt, or creating a project. Without roles.txt it is silent.
#   4. sync   a sync-tool conflict or duplicate file (`x (1).md`, conflicted copy, .sync-conflict-, .icloud)
#
# Versioned in .githooks/ because a hook in .git/hooks/ vanishes on the next clone, and
# `core.hooksPath` is LOCAL config: after cloning, run `sh install.sh`.
# Deliberate bypass: git commit --no-verify

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

for f in core/ring.py core/leak.py core/people.py core/conflicts.py; do
    if [ ! -f "$f" ]; then
        echo "" >&2
        echo "  ⛔ COMMIT BLOCKED — $f does not exist: the installation is incomplete." >&2
        echo "     Run: sh install.sh" >&2
        echo "" >&2
        exit 1
    fi
done

out=$(mktemp) || exit 1
trap 'rm -f "$out"' EXIT
blocked=0

# 1. the ring
if git diff --cached --name-only --diff-filter=ACMR | grep -q '\.md$'; then
    if ! python3 core/ring.py --vault vault --gate --stage >"$out" 2>&1; then
        echo ""
        echo "  ⛔ COMMIT BLOCKED — a note in this commit has no edge in the graph"
        echo ""
        sed 's/^/     /' "$out" | head -20
        blocked=1
    elif grep -q '^WARNING' "$out"; then
        sed -n '/^WARNING/,/^$/p' "$out" | sed 's/^/  /'
    fi
fi

# 2. the leak
if ! python3 core/leak.py --staged >"$out" 2>&1; then
    echo ""
    echo "  ⛔ COMMIT BLOCKED — personal data leak in what is going into the commit"
    echo ""
    sed 's/^/     /' "$out" | head -20
    echo ""
    echo "  Take the data out of the file (the output above says file:line:type, never the data)."
    blocked=1
elif grep -q 'NOT_VERIFIED' "$out"; then
    grep 'NOT_VERIFIED' "$out" | sed 's/^/  /'
fi
# the leak scanner warns when the private list still has its old name (negra.txt)
grep '^WARNING' "$out" | sed 's/^/  /' || true

# 3. the people (team mode). rc 1 = blocked by a rule; rc 2/3 = it could not judge, and not judging is not OK
python3 core/people.py --vault vault --staged >"$out" 2>&1
rc=$?
if [ "$rc" -eq 1 ]; then
    echo ""
    echo "  ⛔ COMMIT BLOCKED — team mode: this commit touches something your role does not own"
    echo ""
    sed 's/^/     /' "$out" | head -20
    echo ""
    echo "  Ask an admin (see vault/roles.txt). This hook is a convention; real enforcement is CODEOWNERS."
    blocked=1
fi
if [ "$rc" -ge 2 ]; then
    echo ""
    echo "  ⛔ COMMIT BLOCKED — team mode could not be verified (vault/roles.txt unreadable, empty or malformed)"
    echo ""
    sed 's/^/     /' "$out" | head -20
    blocked=1
fi

# 4. the sync leftovers. rc 1 = a conflict file is in this commit; rc 2/3 = it could not judge, and not judging is not OK
python3 core/conflicts.py --staged >"$out" 2>&1
rc=$?
if [ "$rc" -ne 0 ]; then
    echo ""
    if [ "$rc" -eq 1 ]; then
        echo "  ⛔ COMMIT BLOCKED — a sync tool left a conflict or duplicate file in this commit"
    else
        echo "  ⛔ COMMIT BLOCKED — the sync-conflict check could not run"
    fi
    echo ""
    sed 's/^/     /' "$out" | head -20
    if [ "$rc" -eq 1 ]; then
        echo ""
        echo "  How to fix: compare the copy with the original (diff), keep the one you want,"
        echo "  delete the other, then commit again. See docs/SYNC.md."
    fi
    blocked=1
fi

[ "$blocked" -eq 0 ] || { echo "  Deliberate bypass: git commit --no-verify"; echo ""; exit 1; }
exit 0
